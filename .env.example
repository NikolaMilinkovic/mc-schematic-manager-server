NODE_ENV=production
PORT=3000

# MongoDB connection string
DATABASE_URL=

# Use strong random strings in production
JWT_SECRET=
SESSION_SECRET=

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=

# Mailtrap
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASSWORD=

# Frontend domain used in password reset links (without protocol)
FRONT_DOMAIN=

# AWS S3 (required for S3-backed uploads/features)
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary credentials
AWS_SESSION_TOKEN=
# Optional startup test key prefix
S3_STARTUP_TEST_PREFIX=startup-checks

# OpenAI (required only if OpenAI endpoints are used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_DEBUG_RESPONSE=false
